# ── Backend Configuration ────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET_KEY=change-this-to-a-long-random-secret-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=2
FLASK_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL / Supabase; falls back to SQLite if omitted)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# RAG & Storage Settings
VECTOR_STORE_PATH=./vector_stores
UPLOAD_FOLDER=./uploads
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=4
RATE_LIMIT_ENABLED=true

# ── Frontend Configuration (.env.production / .env.development) ──────────────
# REACT_APP_API_URL=https://ai-chatbot-w1x8.onrender.com
